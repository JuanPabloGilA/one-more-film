    "media-kit": "tsx scripts/build-media-kit.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "fflate": "^0.8.3",
    "fontkit": "^3.0.0",
    "pdfkit": "^0.21.0",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "svg-to-pdfkit": "^0.1.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
