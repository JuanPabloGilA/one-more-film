{
  "name": "one-more-film",
  "version": "1.0.0",
  "description": "A cinematic movie discovery app powered by TMDB",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
